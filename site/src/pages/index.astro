    --ink: #ececec;
    --copy: #bdbdbd;
    --muted: #8a8a8a;
    --faint: #3a3a3a;
    --rule: #5a5a5a;
    --dash: #2e2e2e;
    --rail: #1c1c1c;
    --signal: #3dff7f;
    --signal-ink: #0a0a0a;
    --signal-text: #3dff7f;
