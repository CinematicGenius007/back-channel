  .section { border-bottom: 1px dashed var(--dash); }
  .section > .body { padding-top: 136px; padding-bottom: 136px; }
  .section-last > .body { padding-bottom: 160px; }
  .section-head { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: flex-end; gap: 12px 24px; margin-bottom: 48px; }
  h2 { font-weight: 800; font-size: clamp(32px, 3.4vw, 44px); line-height: 1.1; letter-spacing: -.04em; }
  .split { display: grid; grid-template-columns: minmax(0, 440px) minmax(0, 1fr); gap: 88px; align-items: start; }
  .split-intro { display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
